# 环境变量模板。复制为 .env.local 后填入真实值：
#   cp .env.example .env.local
# .env.local 已被 .gitignore 忽略，切勿提交任何含真实密钥的 env 文件。

# ── Supabase ────────────────────────────────────────────────
# Dashboard → Project Settings → API

# 项目 URL。构建时必需：next.config.ts 用它配置图片域名白名单，缺失会直接导致构建失败
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# 可公开密钥，会打进浏览器 bundle
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 服务角色密钥，绕过所有 RLS。仅服务端使用，泄露等于交出整个数据库
SUPABASE_SERVICE_ROLE_KEY=

# ── Replicate ───────────────────────────────────────────────
# https://replicate.com/account/api-tokens

REPLICATE_API_TOKEN=
# 账号级 webhook 签名密钥，见 https://replicate.com/account/webhook
# 账号唯一，不随回调地址变化
REPLICATE_WEBHOOK_SECRET=
# Replicate 用户名，训练产出的模型会创建在该账号下
MODEL_OWNER=

# ── 站点地址 ─────────────────────────────────────────────────
# Stripe 付款回跳与 Replicate 训练回调都基于它拼接，必须是外部可访问的地址。
# 本地开发填 ngrok 域名（ngrok http 3000），线上填正式域名。
# 留空时回落到 http://localhost:3000，此时 webhook 收不到回调。

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Resend ──────────────────────────────────────────────────
# https://resend.com/api-keys

RESEND_API_KEY=
# 发件人地址，域名需已在 Resend 验证
RESEND_FROM_EMAIL=

# ── Stripe ──────────────────────────────────────────────────
# Dashboard → Developers → API keys（注意区分测试模式与正式模式）

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
# Webhook 端点的 signing secret。本地用 stripe listen 得到的临时密钥，
# 与 Dashboard 端点的密钥是两个值，不可混用
STRIPE_WEBHOOK_SECRET=whsec_

# 切换到正式模式时，不要覆盖上面的测试密钥，而是额外配置下面两个。
# 代码优先读 _LIVE，读不到才回落到测试密钥。
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_LIVE=pk_live_
# STRIPE_SECRET_KEY_LIVE=sk_live_
